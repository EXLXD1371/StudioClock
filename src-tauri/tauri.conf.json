{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio Clock",
  "version": "1.0.1",
  "identifier": "com.studioclock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "演播时钟 · Studio Clock",
      "width": 1120,
      "height": 800,
      "minWidth": 760,
      "minHeight": 660,
      "center": true,
      "decorations": false,
      "backgroundColor": "#090d10",
      "resizable": true,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "演播室时钟与开播计时器",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "displayLanguageSelector": false, "languages": ["SimpChinese"] } }
  }
}
