{
  "name": "studio-clock",
  "private": true,
  "version": "1.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ui": "playwright test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "android:web": "vue-tsc --noEmit && vite build --mode android",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-release.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2.10.1",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14",
    "vue-tsc": "^3.1.5"
  }
}
